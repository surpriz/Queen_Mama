# Application Environment
# Options: development, staging, production
VITE_APP_ENV=development

# Sentry DSN for error tracking (renderer process)
# Also set SENTRY_DSN for main process (same value)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Google OAuth Client ID for Desktop/Electron
# This should be a "Desktop" type OAuth client from Google Cloud Console
# It must support loopback redirects (http://127.0.0.1:PORT/callback)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
