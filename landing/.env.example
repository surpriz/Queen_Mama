# Database
DATABASE_URL="postgresql://user:password@localhost:5432/queenmama"

# NextAuth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"

# OAuth Providers (optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# Encryption (for API keys storage)
ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# JWT and License signing
JWT_SECRET="generate-with: openssl rand -base64 32"
LICENSE_SECRET="generate-with: openssl rand -hex 32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Admin API Keys (for proxy service)
DEEPGRAM_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
ASSEMBLYAI_API_KEY=""

# GitHub (for private repo downloads)
# Create a fine-grained PAT with "Contents: Read" permission
GITHUB_TOKEN=""

# Apple In-App Purchase (StoreKit 2 / App Store Server Notifications V2)
# Key ID + Issuer ID + Private Key: App Store Connect > Users and Access > Integrations > In-App Purchase
# (only needed for App Store Server API calls; JWS verification uses the bundled root CAs)
APPLE_IAP_KEY_ID=""
APPLE_IAP_ISSUER_ID=""
APPLE_IAP_PRIVATE_KEY=""
APPLE_BUNDLE_ID="com.queenmama.ios"
# Numeric Apple ID of the app (App Store Connect > App Information) - required in Production
APPLE_APP_APPLE_ID=""
# "Sandbox" or "Production"
APPLE_IAP_ENVIRONMENT="Sandbox"
# Optional override for the Apple root CA directory (defaults to lib/apple-certs)
# APPLE_ROOT_CA_DIR=""
