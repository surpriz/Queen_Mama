{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"tsx -r tsconfig-paths/register scripts/start-transcription-proxy.ts\"",
    "dev:next": "next dev",
    "dev:proxy": "tsx -r tsconfig-paths/register scripts/start-transcription-proxy.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:models": "tsx scripts/test-model-ids.ts",
    "benchmark": "tsx scripts/benchmark-models.ts",
    "benchmark:quality": "tsx scripts/benchmark-quality.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-ses": "^3.971.0",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@sentry/nextjs": "^10.36.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "jose": "^6.1.3",
    "lucide-react": "^1.7.0",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.2",
    "papaparse": "^5.5.3",
    "posthog-js": "^1.335.2",
    "posthog-node": "^5.21.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.1.2",
    "tailwind-merge": "^3.4.0",
    "unpdf": "^1.6.2",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^28.0.0",
    "msw": "^2.12.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}
