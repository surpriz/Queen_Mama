{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\n" : {
      "comment" : "A new line in a transcript.",
      "isCommentAutoGenerated" : true
    },
    " " : {

    },
    "%@ (%@)" : {
      "comment" : "The current version and build number of the app, displayed in a bold font with a link to open the app in the App Store.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A badge displaying the number of sessions a contact has had. The argument is the count of sessions the contact has had.",
      "isCommentAutoGenerated" : true
    },
    "%lld / %lld remaining" : {
      "comment" : "A label showing the number of remaining and total uses for a rate-limited feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld / %2$lld remaining"
          }
        }
      }
    },
    "%lld." : {
      "comment" : "A bullet point prefixed with a number, used to list items in a numbered list. The number is automatically generated based on the order in which the items are listed.",
      "isCommentAutoGenerated" : true
    },
    "%lld/%lld" : {
      "comment" : "A text label showing the number of free requests remaining, followed by a count of the total number of requests allowed. Both values are displayed in a monospaced font with a small padding. A capsule background is applied to indicate whether the limit has been reached.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld%%" : {
      "comment" : "A small label displaying the percentage of the total talk time that is attributed to the user.",
      "isCommentAutoGenerated" : true
    },
    "%llds" : {
      "comment" : "The current value of the screen capture interval, displayed in seconds.",
      "isCommentAutoGenerated" : true
    },
    "•" : {
      "comment" : "A bullet point symbol.",
      "isCommentAutoGenerated" : true
    },
